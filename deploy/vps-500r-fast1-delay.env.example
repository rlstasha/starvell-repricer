# Fast1 low-delay VPS benchmark profile.
#
# Apply after deploy/vps-500r-safe.env.example has passed a live check.
# This keeps the global/account budget unchanged and only reduces the local
# pacing delay for the fast_1 worker group.

FAST1_MIN_DELAY_MS=50
FAST1_JITTER_MS=25

# Keep other groups on safe pacing unless a separate live test proves otherwise.
FAST2_MIN_DELAY_MS=
FAST2_JITTER_MS=
SLOW_MIN_DELAY_MS=
SLOW_JITTER_MS=
