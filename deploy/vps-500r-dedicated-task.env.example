# Dedicated 500R scheduler task VPS benchmark profile.
#
# Apply after the safe profile and fast1 low-delay profile have passed live
# checks. This makes 500R run in its own opt-in scheduler loop while 800/1000
# remain on the bounded heap scheduler.

DEDICATED_POSITION_TASKS_ENABLED=true
DEDICATED_POSITION_TASKS=500
DEDICATED_POSITION_IDLE_SLEEP_SECONDS=0.05
