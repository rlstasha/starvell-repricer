# Safe VPS runtime profile for 500R latency tuning.
#
# Apply these values to /root/starvell-repricer/.env on the VPS before the
# first live benchmark stage. Secrets are intentionally not included here.

GLOBAL_REQUEST_LIMIT_PER_MINUTE=240
ACCOUNT_EFFECTIVE_LIMIT_PER_MINUTE=240
RATE_LIMITER_SOFT_CAP_ENABLED=true
SCHEDULER_MAX_CONCURRENT_POSITIONS=2

WORKER_FAST_1_POSITIONS=500,800,1000
WORKER_FAST_1_REQUEST_LIMIT_PER_MINUTE=120
WORKER_FAST_2_POSITIONS=400,1200,2000
WORKER_FAST_2_REQUEST_LIMIT_PER_MINUTE=90
WORKER_SLOW_POSITIONS=40,80,200,1700,2100,2500,3600,4500,10000,22500
WORKER_SLOW_REQUEST_LIMIT_PER_MINUTE=30

PROXY_FAST_1_POSITIONS=500,800,1000
PROXY_FAST_1_REQUEST_LIMIT_PER_MINUTE=120
PROXY_FAST_2_POSITIONS=400,1200,2000
PROXY_FAST_2_REQUEST_LIMIT_PER_MINUTE=90
PROXY_SLOW_POSITIONS=40,80,200,1700,2100,2500,3600,4500,10000,22500
PROXY_SLOW_REQUEST_LIMIT_PER_MINUTE=30

REQUEST_MIN_DELAY_MS=300
REQUEST_JITTER_MS=200
FAST1_MIN_DELAY_MS=200
FAST1_JITTER_MS=100
FAST2_MIN_DELAY_MS=
FAST2_JITTER_MS=
SLOW_MIN_DELAY_MS=
SLOW_JITTER_MS=

ULTRA_FAST_MIN_INTERVAL_SECONDS=0.4
FAST1_MIN_INTERVAL_SECONDS=0.8
FAST2_MIN_INTERVAL_SECONDS=2.0
SLOW_MIN_INTERVAL_SECONDS=9.0
SLOW_MAX_INTERVAL_SECONDS=15.0

MY_LOT_STATE_CACHE_TTL_SECONDS=30
POST_UPDATE_INTERVAL_MULTIPLIER=1.0
POST_UPDATE_INTERVAL_POSITIONS=500

PRICE_WATCHER_ENABLED=false
PRICE_WATCHER_INTERVAL_MS=300
PRICE_WATCHER_POSITIONS=500,800,1000
PRICE_WATCHER_TOP_COMPETITORS=3
PRICE_WATCHER_COMPETITOR_REFRESH_SECONDS=30
