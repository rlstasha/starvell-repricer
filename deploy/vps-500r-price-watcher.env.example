# Optional price watcher VPS benchmark profile.
#
# Apply only after the dedicated 500R scheduler task has passed a live check.
# The watcher is read-only: it observes competitor offer Next.js JSON and writes
# short-lived Redis hints for the scheduler.

PRICE_WATCHER_ENABLED=true
PRICE_WATCHER_INTERVAL_MS=300
PRICE_WATCHER_POSITIONS=500,800,1000
PRICE_WATCHER_TOP_COMPETITORS=3
PRICE_WATCHER_COMPETITOR_REFRESH_SECONDS=30
WATCHER_EVENT_FAST_PATH_ENABLED=true
WATCHER_EVENT_OWN_LOT_CACHE_MAX_AGE_SECONDS=30
