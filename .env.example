APP_ENV=production
APP_MODE=all
LOG_LEVEL=INFO
DRY_RUN=true

POSTGRES_DB=repricer
POSTGRES_USER=repricer
POSTGRES_PASSWORD=change_me_strong_password
REDIS_PASSWORD=

DATABASE_URL=postgresql+asyncpg://repricer:repricer@postgres:5432/repricer
REDIS_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN=put_new_bot_token_here
OWNER_TELEGRAM_IDS=123456789,987654321
OWNER_TELEGRAM_ID=123456789
TELEGRAM_FORCE_IPV4=true
# Docker/VPS fallback for api.telegram.org when container DNS returns only IPv6.
# Leave empty to use IPv4 DNS. Set to the host-resolved Telegram IPv4 if needed.
TELEGRAM_API_IPV4=

MARKET_BASE_URL=https://starvell.com
MARKET_API_TOKEN=
MARKET_SESSION_COOKIE=
MARKET_CSRF_TOKEN=
MARKET_ACCOUNT_INFO_URL=
MARKET_MY_LOTS_URL=
MARKET_OFFERS_URL=/roblox/packages
MARKET_OFFERS_API_URL=/api/offers/list-by-category
MARKET_OFFERS_LIMIT=100
MARKET_CATEGORY_CACHE_TTL_SECONDS=1.5
MARKET_HTTP2_ENABLED=false
MARKET_HTTP_TIMEOUT_SECONDS=15
MARKET_HTTP_MAX_CONNECTIONS=20
MARKET_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
MY_LOT_STATE_CACHE_TTL_SECONDS=30
PRICE_UPDATE_CONTEXT_CACHE_TTL_SECONDS=300
ENABLE_REAL_PRICE_WRITES=false
MARKET_UPDATE_LOT_PRICE_URL=https://starvell.com/api/offers/{lot_id}/partial-update
MARKET_UPDATE_LOT_PRICE_METHOD=POST
MARKET_UPDATE_PRICE_PAYLOAD_STYLE=partial_update
MARKET_UPDATE_PRICE_CONTENT_TYPE=json
PRICE_WRITE_DISCOVERY=false

OWN_SELLER_ID=
OWN_SELLER_USERNAME=

PROXY_MODE=enabled
PROXY_FAST_1_URL=
PROXY_FAST_2_URL=
PROXY_SLOW_URL=
PROXY_FAST_1_POSITIONS=500
PROXY_FAST_2_POSITIONS=400,800,1000,1200,1700,2000
PROXY_SLOW_POSITIONS=40,80,200,2100,2500,3600,4500,10000,22500
PROXY_FAST_1_REQUEST_LIMIT_PER_MINUTE=100
PROXY_FAST_2_REQUEST_LIMIT_PER_MINUTE=90
PROXY_SLOW_REQUEST_LIMIT_PER_MINUTE=50
REQUEST_BURST_LIMIT=5
REQUEST_MIN_DELAY_MS=300
REQUEST_MAX_DELAY_MS=5000
REQUEST_JITTER_MS=200
FAST1_MIN_DELAY_MS=200
FAST1_JITTER_MS=100
FAST2_MIN_DELAY_MS=
FAST2_JITTER_MS=
SLOW_MIN_DELAY_MS=
SLOW_JITTER_MS=
REQUEST_BACKOFF_FACTOR=2
SAFE_MODE_ENABLED=true
SAFE_MODE_ON_429=true
SAFE_MODE_ON_403=true
SAFE_MODE_COOLDOWN_SECONDS=300

REQUEST_LIMIT_PER_MINUTE=100
GLOBAL_REQUEST_LIMIT_PER_MINUTE=240
TOKEN_LIMIT_MODE=true
RATE_LIMITER_SOFT_CAP_ENABLED=true
ACCOUNT_EFFECTIVE_LIMIT_PER_MINUTE=240
ACCOUNT_MIN_LIMIT_PER_MINUTE=60
ACCOUNT_LIMIT_DECREASE_STEP_PER_MINUTE=30
ACCOUNT_LIMIT_RAMP_STEP_PER_MINUTE=30
ACCOUNT_LIMIT_RAMP_IDLE_SECONDS=60
RAMP_STEP_PER_MINUTE=30
RAMP_IDLE_SECONDS=60
WORKER_GROUP=all
WORKER_FAST_1_REQUEST_LIMIT_PER_MINUTE=100
WORKER_FAST_2_REQUEST_LIMIT_PER_MINUTE=90
WORKER_SLOW_REQUEST_LIMIT_PER_MINUTE=50
WORKER_FAST_1_POSITIONS=500
WORKER_FAST_2_POSITIONS=400,800,1000,1200,1700,2000
WORKER_SLOW_POSITIONS=40,80,200,2100,2500,3600,4500,10000,22500
POSITION_LOCK_TTL_SECONDS=30
WORKER_ERROR_BACKOFF_SECONDS=10
WORKER_SAFE_MODE_ERROR_THRESHOLD=5
WORKER_SAFE_MODE_SECONDS=60
PUBLIC_IP=

DEFAULT_MIN_RATING=4.5
DEFAULT_PRICE_STEP=1
DEFAULT_IGNORE_NO_RATING=true
DEFAULT_FALLBACK_BEHAVIOR=keep_current
DEFAULT_MIN_PRICE=0
DEFAULT_MAX_PRICE=999999

HIGH_PRIORITY_PERCENT=70
NORMAL_PRIORITY_PERCENT=30
SCHEDULER_IDLE_SLEEP_SECONDS=1
FAST1_IDLE_SLEEP_SECONDS=0.1
FAST2_IDLE_SLEEP_SECONDS=0.1
SLOW_IDLE_SLEEP_SECONDS=1.0
SCHEDULER_MAX_CONCURRENT_POSITIONS=2
ULTRA_FAST_MIN_INTERVAL_SECONDS=0.4
FAST1_MIN_INTERVAL_SECONDS=0.8
FAST2_MIN_INTERVAL_SECONDS=2.0
HOT_MODE_ENABLED=false
HOT_MODE_MIN_INTERVAL_SECONDS=0.25
HOT_MODE_MAX_INTERVAL_SECONDS=0.5
HOT_MODE_COOLDOWN_INTERVAL_SECONDS=1.0
HOT_MODE_SKIPPED_THRESHOLD=3
HOT_MODE_WINDOW_SECONDS=10
FAST_MODE_ENABLED=false
FAST_MODE_MIN_INTERVAL_SECONDS=0.8
FAST_MODE_MAX_INTERVAL_SECONDS=1.2
FAST_MODE_COOLDOWN_MIN_INTERVAL_SECONDS=1.5
FAST_MODE_COOLDOWN_MAX_INTERVAL_SECONDS=2.5
POST_UPDATE_INTERVAL_MULTIPLIER=1.0
POST_UPDATE_INTERVAL_POSITIONS=500
